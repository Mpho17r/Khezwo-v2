# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in Supabase Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only in server actions that need to bypass RLS (e.g. admin promoting
# a vendor, platform-wide stats). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build QR codes / tracking links. Set to your real domain
# in production (e.g. https://khezwo.co.za).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
